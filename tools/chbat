#!/usr/bin/env python3
"""Run the one-shot Charybdis battery reader through uv."""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path


def main() -> None:
    uv = shutil.which("uv")
    if uv is None:
        raise SystemExit("chbat: uv is not installed or is not in PATH")

    reader = Path(__file__).resolve().with_name("battery_tui.py")
    os.execv(uv, [uv, "run", str(reader), *sys.argv[1:]])


if __name__ == "__main__":
    main()
